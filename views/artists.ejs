<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>好きなアーティスト図鑑</title>
</head>
<body>
  <h2>好きなアーティスト図鑑</h2>
  <table>
    <tr><th>ID</th><th>アーティスト名</th><th>ジャンル</th></tr>
    <% let number = 0 %>
    <% for( let row of data ) { %>
      <tr><td><%= row.id %></td>
      <td><a href="/artists/<%= number %>"><%= row.name %></a></td>
      <td><%= row.genre %></td></tr>
      <% number += 1 %>
    <% } %>
  </table>
</body>
</html>